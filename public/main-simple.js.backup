// ===== APPLICATION INITIALIZATION =====
// Initialize when DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initializeAfterDOM);
} else {
  initializeAfterDOM();
}

function initializeAfterDOM() {
  console.log('🚀 DOM ready, initializing application...');
  
  // Initialize GLTFLoader and then start the game
  if (typeof THREE !== 'undefined') {
    if (typeof THREE.GLTFLoader === 'undefined' && typeof GLTFLoader !== 'undefined') {
      THREE.GLTFLoader = GLTFLoader;
    }
    
    // Initialize menu system first
    initMenuSystem();
    
    // Then initialize game components
    initializeGameComponents();
    
    console.log('✅ Application initialized successfully');
  } else {
    console.error('❌ Cannot initialize without Three.js');
  }
}

